         这条必须留着，否则 Android 7+ 把文件交给文件管理器/图库时会抛 FileUriExposedException -->
    <external-files-path name="ext_files" path="." />
    <cache-path name="my_cache_images" path="." />
    <files-path name="internal_files" path="." />
</paths>
