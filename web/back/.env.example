# BakerAI 新后端 · 配置样例
#
# 用法：复制成 .env 再改（.env 不进版本库）。
# 所有变量都带 BAKER_ 前缀，避免和系统里别的东西撞名。
# 下面这些值就是本地开发能直接跑的那套，别乱改端口 —— 3307 是给这个项目专用的，
# 3306 是 CloverWebChat 的库，连过去会把另一个项目的表当自己的。

# ---- 数据库 ----
# 格式：mysql+pymysql://用户:密码@主机:端口/库名?charset=utf8mb4
BAKER_DATABASE_URL=mysql+pymysql://baker:baker_local_2026@127.0.0.1:3307/baker_back?charset=utf8mb4

# ---- 服务 ----
BAKER_HOST=127.0.0.1
# 5650 被旧的 cs-backend 原型占着；5660 给新后端
BAKER_PORT=5660
BAKER_LOG_LEVEL=INFO

# ---- 契约（客户端靠这三个数判断"我还需不需要升级"）----
BAKER_API_VERSION=v1
BAKER_SCHEMA_VERSION=1
BAKER_APP_MIN=3.0.0
# lite = 精简版（只聊天）；full = 完整版（另一条产品线，共用同一个后端）
BAKER_PRODUCT=lite

# ---- 出话 ----
# inline  = 自己拼提示词、自己调上游（默认，目标形态）
# gateway = 转给老后端 /chat（过渡期对拍用；老网关下线后这个模式作废）
BAKER_GEN_MODE=inline

BAKER_UPSTREAM_BASE_URL=https://apihub.agnes-ai.com/v1
BAKER_UPSTREAM_MODEL=agnes-2.5-flash
# 上游 key：真出话必须有。没填时 /messages 会回 502，但用户消息仍然会存下来（不会丢话）
BAKER_UPSTREAM_API_KEY=
BAKER_UPSTREAM_TIMEOUT=60
BAKER_UPSTREAM_MAX_TOKENS=2048
BAKER_UPSTREAM_TEMPERATURE=0.8

# gen_mode=gateway 时，老后端的地址
BAKER_GATEWAY_URL=http://127.0.0.1:5500

# ---- 限流 ----
# 每台设备每分钟最多几次"出话"（只存不发的 generate=false 不计数）
BAKER_USER_RPM=12
# 借不到空闲 key 时最多等多久（**不限制同时在线的用户数**，排队而不是拒绝）
BAKER_KEY_WAIT_SECONDS=20

# ---- 世界书检索 ----
BAKER_WORLDBOOK_ENABLED=true
BAKER_WORLDBOOK_SLUG=endfield
# 每轮预取正文的 token 预算（终端同值）
BAKER_WORLDBOOK_BUDGET_TOKENS=2000
# 是否每轮把整份索引（147 条目录，约 4k token）塞进 system。关掉更省，但模型"不知道有这条设定"
BAKER_WORLDBOOK_INDEX_ENABLED=true

# ---- 上下文预算 ----
# 单轮提示词总预算（估算 token）。超了就裁历史，固定前缀（协议/世界观/角色）永不裁。
BAKER_PROMPT_BUDGET_TOKENS=40000
# 给回复留的余量，别让历史把预算吃满
BAKER_REPLY_RESERVE_TOKENS=4096

# ---- 摘要 / 压缩 ----
# 待压缩历史超过这个估算 token 数就压一次（0 = 关闭）
BAKER_AUTO_COMPRESS_TOKENS=12000
# 压缩时保留最近几轮原文（1 轮 = 用户 + 角色两条）
BAKER_KEEP_RECENT_TURNS=4
BAKER_SUMMARY_MAX_TOKENS=1400

# ---- key 加密 ----
# api_keys.key_enc 的加密密钥（AES-256-GCM）。
# ⚠ 换了它，库里已存的 key 全部解不开 —— 换之前先用旧值解密再重新导入。
BAKER_SECRET=please-change-me-to-a-random-48-hex

# ---- key 池 ----
BAKER_KEY_RPM_DEFAULT=10
BAKER_KEY_COOLDOWN_SECONDS=60
BAKER_KEY_FAIL_LIMIT=3
